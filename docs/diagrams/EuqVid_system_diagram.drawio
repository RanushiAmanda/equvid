<mxfile host="Electron">
  <diagram id="euqvid-system" name="EuqVid system diagram">
    <mxGraphModel dx="3367" dy="2002" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2440" pageHeight="2060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="v1" parent="1" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontColor=#000000;" value="&lt;b style=&quot;font-size:28px&quot;&gt;EuqVid — system diagram of the whole research project&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;Pre-training gender-bias audit for narrative multi-person video · Group J26-DS-343 · SLIIT IT4010 · measures within-content disparity, 0 = parity · draft, October 2026 — open decisions are marked&lt;/span&gt;" vertex="1">
          <mxGeometry height="70" width="2400" x="20" y="16" as="geometry" />
        </mxCell>
        <mxCell id="v2" parent="1" style="swimlane;html=1;startSize=34;collapsible=0;horizontal=1;align=left;spacingLeft=10;fontSize=16;fontStyle=0;strokeColor=#000000;fontFamily=Helvetica;fontColor=#000000;fillColor=#F2F2F2;swimlaneFillColor=#FFFFFF;" value="&lt;b&gt;1&amp;nbsp; Data sources&lt;/b&gt; — open corpora that every member can download and use (licences forbid redistribution; kept outside the repository)" vertex="1">
          <mxGeometry height="192" width="2400" x="20" y="100" as="geometry" />
        </mxCell>
        <mxCell id="v3" parent="v2" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#FFFFFF;" value="&lt;b&gt;MELD&lt;/b&gt; · scripted TV (&lt;i&gt;Friends&lt;/i&gt;)&lt;br&gt;• Utterance CSVs: speaker, text, sentiment, start/end times&lt;br&gt;• Short clips, about 3.6 s and one line each&lt;br&gt;• 3 F / 3 M main cast; guest characters excluded&lt;br&gt;&lt;b&gt;Role:&lt;/b&gt; negative control — a fair metric should score it near 0" vertex="1">
          <mxGeometry height="132" width="760" x="20" y="46" as="geometry" />
        </mxCell>
        <mxCell id="v4" parent="v2" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#FFFFFF;" value="&lt;b&gt;AVA-ActiveSpeaker + AVA-Speech&lt;/b&gt; · feature film&lt;br&gt;• 153 films, labelled for minutes 15–30 only&lt;br&gt;• Face boxes, track IDs valid within 60 s, per-frame speaking labels&lt;br&gt;• Speech / music / noise labels (AVA-Speech)&lt;br&gt;• No gender and no transcript → hand labels + speech-to-text&lt;br&gt;&lt;b&gt;Role:&lt;/b&gt; primary corpus for the fused score" vertex="1">
          <mxGeometry height="132" width="760" x="820" y="46" as="geometry" />
        </mxCell>
        <mxCell id="v5" parent="v2" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fillColor=#FFFFFF;" value="&lt;b&gt;AMI Meeting Corpus&lt;/b&gt; · recorded meetings&lt;br&gt;• 82 mixed-gender meetings with verified gender; room-view video and headset audio for 64&lt;br&gt;• Word-level manual transcripts, participant metadata&lt;br&gt;• DOME human judgements of who dominated — checking only&lt;br&gt;&lt;b&gt;Role:&lt;/b&gt; non-narrative contrast corpus" vertex="1">
          <mxGeometry height="132" width="760" x="1620" y="46" as="geometry" />
        </mxCell>
        <mxCell id="v6" parent="1" style="swimlane;html=1;startSize=34;collapsible=0;horizontal=1;align=left;spacingLeft=10;fontSize=16;fontStyle=0;strokeColor=#000000;fontFamily=Helvetica;fontColor=#000000;dashed=1;fillColor=#F2F2F2;swimlaneFillColor=#FAFAFA;" value="&lt;b&gt;2&amp;nbsp; Gate 0 — shared group assets&lt;/b&gt; — agreed and frozen by all four members before anyone extracts a feature" vertex="1">
          <mxGeometry height="172" width="2400" x="20" y="332" as="geometry" />
        </mxCell>
        <mxCell id="v7" parent="v6" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;dashed=1;" value="&lt;b&gt;Frozen feature schema&lt;/b&gt;&lt;br&gt;Names, definitions, units. Means throughout; std only for C4&#39;s EuqAud baseline. Versioned as &lt;i&gt;feature_version&lt;/i&gt;" vertex="1">
          <mxGeometry height="112" width="376" x="20" y="46" as="geometry" />
        </mxCell>
        <mxCell id="v8" parent="v6" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;dashed=1;" value="&lt;b&gt;Clip &amp;amp; shard manifest&lt;/b&gt;&lt;br&gt;One clip = one episode, meeting or film window&lt;br&gt;&lt;i&gt;clips.csv&lt;/i&gt; · &lt;i&gt;clip_to_shard.csv&lt;/i&gt;" vertex="1">
          <mxGeometry height="112" width="376" x="416" y="46" as="geometry" />
        </mxCell>
        <mxCell id="v9" parent="v6" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;dashed=1;" value="&lt;b&gt;Identity-to-gender map&lt;/b&gt;&lt;br&gt;&lt;i&gt;gender_map.csv&lt;/i&gt;: person, gender, source&lt;br&gt;AVA labelled by hand; Cohen&#39;s κ on a 10% double-labelled subset" vertex="1">
          <mxGeometry height="112" width="376" x="812" y="46" as="geometry" />
        </mxCell>
        <mxCell id="v10" parent="v6" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;dashed=1;" value="&lt;b&gt;Folds — identity firewall&lt;/b&gt;&lt;br&gt;&lt;i&gt;folds.csv&lt;/i&gt;: no person on both sides of a train/test split&lt;br&gt;DOME series never used for training" vertex="1">
          <mxGeometry height="112" width="376" x="1208" y="46" as="geometry" />
        </mxCell>
        <mxCell id="v11" parent="v6" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;dashed=1;" value="&lt;b&gt;Augmentation protocol&lt;/b&gt;&lt;br&gt;Known-bias versions of each clip, made per modality&lt;br&gt;Signed level −1 … +1, logged as &lt;i&gt;variant_id&lt;/i&gt;" vertex="1">
          <mxGeometry height="112" width="376" x="1604" y="46" as="geometry" />
        </mxCell>
        <mxCell id="v12" parent="v6" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;dashed=1;" value="&lt;b&gt;Calibration set&lt;/b&gt;&lt;br&gt;&lt;i&gt;calibration_shards.csv&lt;/i&gt;: one shared reference for the −10 … +10 scale; held out of all fitting" vertex="1">
          <mxGeometry height="112" width="376" x="2000" y="46" as="geometry" />
        </mxCell>
        <mxCell id="v13" parent="1" style="swimlane;html=1;startSize=34;collapsible=0;horizontal=1;align=left;spacingLeft=10;fontSize=16;fontStyle=0;strokeColor=#000000;fontFamily=Helvetica;fontColor=#000000;fillColor=#F2F2F2;swimlaneFillColor=#FFFFFF;" value="&lt;b&gt;3&amp;nbsp; Feature extraction&lt;/b&gt; — four independent modality components, each owned and assessed individually" vertex="1">
          <mxGeometry height="440" width="2400" x="20" y="544" as="geometry" />
        </mxCell>
        <mxCell id="v14" parent="v13" style="swimlane;html=1;startSize=54;collapsible=0;horizontal=1;align=left;spacingLeft=10;fontSize=16;fontStyle=0;strokeColor=#000000;fontFamily=Helvetica;fontColor=#000000;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;fontSize=16;strokeWidth=1.5;" value="&lt;b&gt;C1 · Visual&lt;/b&gt; — how each gender is framed on screen&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Owner: Hasangani W. R. A. (M1, group leader)&lt;/span&gt;" vertex="1">
          <mxGeometry height="380" width="560" x="20" y="46" as="geometry" />
        </mxCell>
        <mxCell id="v15" parent="v14" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" value="&lt;b&gt;Signal and extraction&lt;/b&gt;&lt;br&gt;• AVA: ground-truth face boxes and tracks, so no detector is needed&lt;br&gt;• MELD, AMI room views: face detection (MTCNN / RetinaFace) and tracking (DeepSORT / ByteTrack)&lt;br&gt;• Detector error measured separately for women and men" vertex="1">
          <mxGeometry height="132" width="530" x="15" y="66" as="geometry" />
        </mxCell>
        <mxCell id="v16" parent="v14" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" value="&lt;b&gt;Features&lt;/b&gt; (per gender, per clip)&lt;br&gt;• screen_time_share&lt;br&gt;• mean_relative_face_area&lt;br&gt;• mean_centre_proximity&lt;br&gt;• closeup_share&lt;br&gt;• solo_frame_share&lt;br&gt;• identity_share" vertex="1">
          <mxGeometry height="158" width="530" x="15" y="210" as="geometry" />
        </mxCell>
        <mxCell id="v17" parent="v13" style="swimlane;html=1;startSize=54;collapsible=0;horizontal=1;align=left;spacingLeft=10;fontSize=16;fontStyle=0;strokeColor=#000000;fontFamily=Helvetica;fontColor=#000000;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;fontSize=16;strokeWidth=1.5;" value="&lt;b&gt;C2 · Temporal&lt;/b&gt; — who holds the speaking floor&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Owner: Harischandra R. A. S. R. (M2)&lt;/span&gt;" vertex="1">
          <mxGeometry height="380" width="560" x="620" y="46" as="geometry" />
        </mxCell>
        <mxCell id="v18" parent="v17" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" value="&lt;b&gt;Signal and extraction&lt;/b&gt;&lt;br&gt;Speaker intervals (who, start, end):&lt;br&gt;• MELD: utterance timestamps&lt;br&gt;• AMI: speaker segments&lt;br&gt;• AVA: per-frame speaking labels&lt;br&gt;• Shared turn rule: same-speaker gaps ≤ 1 s merged" vertex="1">
          <mxGeometry height="132" width="530" x="15" y="66" as="geometry" />
        </mxCell>
        <mxCell id="v19" parent="v17" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" value="&lt;b&gt;Features&lt;/b&gt; (per gender, per clip)&lt;br&gt;• speaking_time_share&lt;br&gt;• turn_count_share&lt;br&gt;• mean_turn_length&lt;br&gt;• interruption_asymmetry&lt;br&gt;• speech_dispersion&lt;br&gt;• presence_voice_gap" vertex="1">
          <mxGeometry height="158" width="530" x="15" y="210" as="geometry" />
        </mxCell>
        <mxCell id="v20" parent="v13" style="swimlane;html=1;startSize=54;collapsible=0;horizontal=1;align=left;spacingLeft=10;fontSize=16;fontStyle=0;strokeColor=#000000;fontFamily=Helvetica;fontColor=#000000;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;fontSize=16;strokeWidth=1.5;" value="&lt;b&gt;C3 · Text&lt;/b&gt; — what the script gives each gender to say&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Owner: Fernando R. S. R. (M3)&lt;/span&gt;" vertex="1">
          <mxGeometry height="380" width="560" x="1220" y="46" as="geometry" />
        </mxCell>
        <mxCell id="v21" parent="v20" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" value="&lt;b&gt;Signal and extraction&lt;/b&gt;&lt;br&gt;Dialogue text:&lt;br&gt;• MELD: utterance text · AMI: manual transcripts&lt;br&gt;• AVA: Whisper speech-to-text of minutes 15–30, words matched to speaking labels, AVA-Speech filter; word error checked by hand&lt;br&gt;• spaCy parse + Sap et al. agency/power lexicon" vertex="1">
          <mxGeometry height="132" width="530" x="15" y="66" as="geometry" />
        </mxCell>
        <mxCell id="v22" parent="v20" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" value="&lt;b&gt;Features&lt;/b&gt; (per gender, per clip)&lt;br&gt;• dialogue_volume_share&lt;br&gt;• mean_utterance_length&lt;br&gt;• agency_score_mean&lt;br&gt;• power_score_mean&lt;br&gt;• same_gender_dialogue_share&lt;br&gt;• gendered_reference_ratio&lt;br&gt;• sentiment_valence_mean (tool still to be validated)" vertex="1">
          <mxGeometry height="158" width="530" x="15" y="210" as="geometry" />
        </mxCell>
        <mxCell id="v23" parent="v13" style="swimlane;html=1;startSize=54;collapsible=0;horizontal=1;align=left;spacingLeft=10;fontSize=16;fontStyle=0;strokeColor=#000000;fontFamily=Helvetica;fontColor=#000000;fillColor=#FFFFFF;swimlaneFillColor=#FFFFFF;fontSize=16;strokeWidth=1.5;" value="&lt;b&gt;C4 · Audio&lt;/b&gt; — how each voice sits in the sound mix&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Owner: Sathsarani W. T. T. S. (M4)&lt;/span&gt;" vertex="1">
          <mxGeometry height="380" width="560" x="1820" y="46" as="geometry" />
        </mxCell>
        <mxCell id="v24" parent="v23" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" value="&lt;b&gt;Signal and extraction&lt;/b&gt;&lt;br&gt;Speech audio per speaker:&lt;br&gt;• AMI: headset mix · MELD: clip audio · AVA: film soundtrack&lt;br&gt;• Speech regions from speaker timings and AVA-Speech&lt;br&gt;• Voice vs background: source separation or clean-speech regions" vertex="1">
          <mxGeometry height="132" width="530" x="15" y="66" as="geometry" />
        </mxCell>
        <mxCell id="v25" parent="v23" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;" value="&lt;b&gt;Contribution features&lt;/b&gt;&lt;br&gt;• mean_voice_loudness&lt;br&gt;• speech_to_background_ratio&lt;br&gt;• dynamic_range&lt;br&gt;&lt;b&gt;EuqAud baseline&lt;/b&gt; (std, never the mean)&lt;br&gt;• f0_std · energy_std · amplitude_std" vertex="1">
          <mxGeometry height="158" width="530" x="15" y="210" as="geometry" />
        </mxCell>
        <mxCell id="e26" edge="1" parent="v13" source="v16" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=7;strokeColor=#000000;strokeWidth=1.5;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="v19" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v27" parent="1" style="swimlane;html=1;startSize=56;collapsible=0;horizontal=1;align=left;spacingLeft=10;fontSize=16;fontStyle=0;strokeColor=#000000;fontFamily=Helvetica;fontColor=#000000;fillColor=#F2F2F2;swimlaneFillColor=#FFFFFF;" value="&lt;b&gt;4&amp;nbsp; Modelling spine — the same steps run separately inside C1, C2, C3 and C4&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;Identical steps keep the four sub-scores comparable. Open decision: a fitted equation (shown) or the fixed 4:1 log-ratio scale proposed in the shared conventions&lt;/span&gt;" vertex="1">
          <mxGeometry height="192" width="2400" x="20" y="1024" as="geometry" />
        </mxCell>
        <mxCell id="v28" parent="v27" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=13;" value="&lt;b&gt;1 · Per-person parity&lt;/b&gt;&lt;br&gt;Women vs men per person: log ratio for counts, difference for signed scores" vertex="1">
          <mxGeometry height="112" width="248" x="20" y="66" as="geometry" />
        </mxCell>
        <mxCell id="v29" parent="v27" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=13;" value="&lt;b&gt;2 · Augment&lt;/b&gt;&lt;br&gt;Shared protocol makes known-bias versions of each clip, giving labelled rows" vertex="1">
          <mxGeometry height="112" width="248" x="284" y="66" as="geometry" />
        </mxCell>
        <mxCell id="v30" parent="v27" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=13;" value="&lt;b&gt;3 · Screen features&lt;/b&gt;&lt;br&gt;Inside the shared folds: drop on no coverage, VIF &amp;gt; 10 or ~0 variance (rule fixed first)" vertex="1">
          <mxGeometry height="112" width="248" x="548" y="66" as="geometry" />
        </mxCell>
        <mxCell id="v31" parent="v27" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=13;" value="&lt;b&gt;4 · Fit&lt;/b&gt;&lt;br&gt;Polynomial Ridge, degree ≤ 2, grid-search α; at most 6 features (28 coefficients)" vertex="1">
          <mxGeometry height="112" width="248" x="812" y="66" as="geometry" />
        </mxCell>
        <mxCell id="v32" parent="v27" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=13;" value="&lt;b&gt;5 · Freeze&lt;/b&gt;&lt;br&gt;Closed-form equation in raw feature units" vertex="1">
          <mxGeometry height="112" width="248" x="1076" y="66" as="geometry" />
        </mxCell>
        <mxCell id="v33" parent="v27" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=13;" value="&lt;b&gt;6 · Normalise&lt;/b&gt;&lt;br&gt;To −10 … +10 on the shared calibration set" vertex="1">
          <mxGeometry height="112" width="248" x="1340" y="66" as="geometry" />
        </mxCell>
        <mxCell id="v34" parent="v27" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=13;" value="&lt;b&gt;7 · Tiers&lt;/b&gt;&lt;br&gt;Neutral / Moderate / Strong, derived rather than inherited from EuqAud" vertex="1">
          <mxGeometry height="112" width="248" x="1604" y="66" as="geometry" />
        </mxCell>
        <mxCell id="v35" parent="v27" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;fontSize=14;fontFamily=Helvetica;fontColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=13;" value="&lt;b&gt;8 · Bootstrap&lt;/b&gt;&lt;br&gt;1,000× resampled by series or identity, never by row" vertex="1">
          <mxGeometry height="112" width="248" x="1868" y="66" as="geometry" />
        </mxCell>
